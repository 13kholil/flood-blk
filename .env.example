# Backend Configuration
# Copy this file to backend/.env and adjust values

# Server
PORT=4000
NODE_ENV=development

# CORS - comma-separated origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (leave empty for default: backend/flood.db)
DB_PATH=

# File Upload
UPLOAD_MAX_SIZE=10485760

# Admin API Key for verification endpoints
# Generate with: openssl rand -hex 32
ADMIN_API_KEY=

# BMKG API (optional override)
BMKG_API_BASE=https://bmkg-restapi.vercel.app/v1/weather
BMKG_STATION_CODE=73.02.02.1003

# Frontend
REACT_APP_API_URL=http://localhost:4000
REACT_APP_MAP_CENTER=-5.5544,120.1980
REACT_APP_MAP_ZOOM=14
REACT_APP_BMKG_STATION=73.02.02.1003
REACT_APP_BMKG_API=https://bmkg-restapi.vercel.app/v1/weather
